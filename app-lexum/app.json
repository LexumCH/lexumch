{
  "expo": {
    "name": "Lexum",
    "slug": "lexum-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lexum",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1F2A",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Lexum usa Face ID per proteggere le tue ricerche e i tuoi documenti."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F2A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F2A",
          "image": "./assets/immagini/emblema.png",
          "imageWidth": 120
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "@sentry/react-native",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
